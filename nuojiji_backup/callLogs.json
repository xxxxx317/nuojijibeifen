[{"userId":"uid_1790593509288_migrated","characterId":"char_1787018834938_eo3jk","id":"call_1791367339741_dv1mo9","timestamp":1791367319151,"charId":"char_1787018834938_eo3jk","duration":168,"status":"connected","logs":[{"sender":"ai","content":"喂，小玥。","kind":"speech","timestamp":1791367339735,"ttsGroupTimestamp":1791367339735},{"sender":"ai","content":"这么晚了，还没睡啊？（这么晚了，还没睡啊？）","kind":"speech","timestamp":1791367355777,"ttsGroupTimestamp":1791367355777},{"sender":"ai","content":"我把吉他搁在一边，整个人往工作室那把旧转椅上一靠，随手拿过旁边的咖啡杯抿了一口","kind":"narration","timestamp":1791367355778,"ttsGroupTimestamp":1791367355777},{"sender":"ai","content":"刚还在想你会不会已经睡了呢。（刚还在想你会不会已经睡了呢。）","kind":"speech","timestamp":1791367355779,"ttsGroupTimestamp":1791367355777},{"sender":"ai","content":"我刚才录了一段间奏，那段吉他旋律总是差那么点意思。（我刚才录了一段间奏，那段吉他旋律总是差那么点意思。）","kind":"speech","timestamp":1791367355780,"ttsGroupTimestamp":1791367355777},{"sender":"ai","content":"录到后面耳朵都听麻了，干脆就停下来歇会儿。（录到后面耳朵都听麻了，干脆就停下来歇会儿。）","kind":"speech","timestamp":1791367355781,"ttsGroupTimestamp":1791367355777},{"sender":"ai","content":"结果刚扣上琴盒，手机就亮了。（结果刚扣上琴盒，手机就亮了。）","kind":"speech","timestamp":1791367355782,"ttsGroupTimestamp":1791367355777},{"sender":"ai","content":"你刚才说……如果打过来就能满意点？（你刚才说……如果打过来就能满意点？）","kind":"speech","timestamp":1791367355783,"ttsGroupTimestamp":1791367355777},{"sender":"ai","content":"我垂着眼，用指尖有一搭没一搭地敲着桌面","kind":"narration","timestamp":1791367355784,"ttsGroupTimestamp":1791367355777},{"sender":"ai","content":"那现在听见声音了，这满意度够不够啊？（那现在听见声音了，这满意度够不够啊？）","kind":"speech","timestamp":1791367355785,"ttsGroupTimestamp":1791367355777},{"sender":"ai","content":"要是还不够，我可真不知道该怎么变出别的花样来了。（要是还不够，我可真不知道该怎么变出别的花样来了。）","kind":"speech","timestamp":1791367355786,"ttsGroupTimestamp":1791367355777},{"sender":"user","content":"想你，今天好累","timestamp":1791367396018},{"sender":"ai","content":"累了就赶紧先躺下，别在书桌前撑着了。（累了就赶紧先躺下，别在书桌前撑着了。）","kind":"speech","timestamp":1791367400039,"ttsGroupTimestamp":1791367400039},{"sender":"ai","content":"我听着你那边细微的呼吸声，下意识地放轻了音