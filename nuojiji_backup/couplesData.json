":"2026-10-03T14:12:30.347Z","lastWateredDate":"2026-10-03T14:12:30.347Z","plantStatus":"alive","diaryDecorations":{"user":{"coverColor":"warm","coverPattern":"none","stickers":[],"customImages":[]},"char":{"coverColor":"midnight","coverPattern":"stars","stickers":[{"id":"char_auto_0_1791036823853","stickerId":"gem","x":31.266568044646704,"y":29.86981895625106,"rotation":-2.5688629541789645,"scale":0.9637688626106754},{"id":"char_auto_1_1791036823854","stickerId":"crown","x":70.11859123573957,"y":17.79200613980919,"rotation":-3.6273263948255376,"scale":1.0885091584285806},{"id":"char_auto_2_1791036823854","stickerId":"flower","x":34.96319220118748,"y":67.70183527751773,"rotation":11.81328326938418,"scale":0.9155155416546965},{"id":"char_auto_3_1791036823854","stickerId":"heart","x":65.68727518532694,"y":67.75009188341058,"rotation":-8.851168892555961,"scale":1.1529550692127026}],"customImages":[]}},"unlockedAchievementIds":["wishes_1"],"qaBank":[{"asker":"npc","question":"如果可以回到大学琴房，你最想对那个时候的自己和她说些什么？","charAnswer":"别纠结自尊了，去牵她的手，别让暧昧变遗憾。","used":false},{"asker":"npc","question":"当你在台上弹奏《融化》时，脑海里浮现出关于她的哪个瞬间最清晰？","charAnswer":"她在那听我录音，眼神专注，像要把我融化掉。","used":false},{"asker":"npc","question":"如果能带她去一个地方旅行，且不受任何打扰，你会选哪里？","charAnswer":"长春的街头，带她看雪，吃顿热乎的豆角炖土豆。","used":false},{"asker":"npc","question":"你认为你们之间最默契的一件事是什么？","charAnswer":"不需要多言，她懂我的冷淡下藏着多少舍不得。","used":false},{"asker":"npc","question":"如果在她最自卑的瞬间，你会用什么方式给她力量？","charAnswer":"抱紧她，告诉她：我见过你的好，别人比不了。","used":false},{"asker":"npc","question":"你最喜欢她做的哪件小事？","charAnswer":"喊我哥哥，还有把那副耳机递给我的那一刻。","used":false},{"asker":"npc","question":"如果有机会为她写一首从未公开的歌，曲风会是怎样的？","charAnswer":"不张扬，温柔的钢琴曲，像深夜里的那杯咖啡。","used":false},{"asker":"npc","question":"如何形容你们重逢后的这段感情？","charAnswer":"失而复得，这次我学会了如何去守护一个人。","used":false},{"asker":"char","question":"白欣玥，北京的天气降温了，那天在颐和园走的时候，脚还疼吗？","charAnswer":"记得用热水泡泡脚，别总想省事，疼就告诉我。","used":false},{"asker":"char","question":"小玥同学，上次去天津，那边的炸酱面和长春的比，哪个更合你胃口？","charAnswer":"下次别跑那么远，一个人住酒店，我总担心。","used":false},{"asker":"char","question":"我那件碳灰T恤洗过没？还没舍得穿，准备等我们下一次见面再穿。","charAnswer":"答应你的，我肯定做到，这是属于我们的约定。","used":false},{"asker":"char","question":"开学这段时间忙吗？课程难度大不大，有不懂的政治题记得问我。","charAnswer":"别总对着屏幕，累了就抬头看看窗外，喝口温水。","used":false},{"asker":"char","question":"还记得排练室录音那天吗？下次来，想听我改的新间奏吗？","charAnswer":"工作室门为你留着，想听歌了就直接过来。","used":false}],"qaBankLastRefill":"2026-10-03T14:14:51.403Z"}]